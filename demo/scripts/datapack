#!/usr/bin/env python3
"""Datapack Excel à la charte, depuis une description JSON.

Usage :
    slide-craft datapack <spec.json> --charte=<nom> [-o sortie.xlsx]   rend le classeur
    slide-craft datapack <spec.json> --charte=<nom> --check            vérifie sans rendre
    slide-craft datapack --describe --charte=<nom>                      ce que la charte permet

Sortie par défaut : à côté de la spec, même nom en .xlsx. Code retour 1 si la spec
est invalide, avec une erreur localisée par ligne.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from _common import fail
from lib.charte import Charte
from lib.datapack import DatapackError, describe, render, validate

p = argparse.ArgumentParser(prog="slide-craft datapack")
p.add_argument("spec", nargs="?")
p.add_argument("--charte", required=True)
p.add_argument("-o", "--out")
p.add_argument("--check", action="store_true")
p.add_argument("--describe", action="store_true")
a = p.parse_args()

charte = Charte.load(a.charte)
if a.describe:
    print(json.dumps(describe(charte), ensure_ascii=False, indent=2))
    sys.exit(0)
if not a.spec:
    fail("spec JSON manquante")
spec = json.loads(Path(a.spec).read_text(encoding="utf-8"))
if a.check:
    errors = validate(spec, charte)
    if errors:
        print("\n".join(f"✗ {e}" for e in errors), file=sys.stderr)
        sys.exit(1)
    print("✓ conforme")
    sys.exit(0)
out = Path(a.out) if a.out else Path(a.spec).with_suffix(".xlsx")
try:
    render(spec, charte).save(out)
except DatapackError as e:
    print("\n".join(f"✗ {x}" for x in e.errors), file=sys.stderr)
    sys.exit(1)
print(out)
